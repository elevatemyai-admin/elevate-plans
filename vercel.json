{
  "rewrites": [
    { "source": "/", "destination": "/plan.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
